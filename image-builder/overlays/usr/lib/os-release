# NAME = nom court: c'est CE champ que KDE Discover affiche comme source des
# paquets DEB (ex: "AuxiNux"). PRETTY_NAME garde le nom produit complet.
NAME="AuxiNux OS"
PRETTY_NAME="AuxiNux OS EN 0.1-BETA"
VERSION="0.1-BETA (trixie)"
VERSION_ID="13"
VERSION_CODENAME=trixie
# ID reste debian volontairement: les depots, Brave et apt ciblent Debian 13.
# Seul l'affichage (NAME/PRETTY_NAME) est rebrande AuxiNux pour KDE Discover,
# qui affiche sinon "From Debian GNU/Linux" comme source des paquets DEB.
ID=debian
ID_LIKE=debian
HOME_URL="https://auxinux.ca/"
SUPPORT_URL="https://auxinux.ca/"
BUG_REPORT_URL="https://auxinux.ca/"
LOGO=auxinuxos
