[Desktop Entry]
Type=Application
Name=AuxiNuxOS Welcome
Name[fr]=Bienvenue AuxiNuxOS
Comment=Choose language and learn about AuxiNuxOS
Comment[fr]=Choisir la langue et decouvrir AuxiNuxOS
Exec=auxinux-welcome
Icon=auxinuxos
# OnlyShowIn=KDE et les cles X-KDE-* ont ete retirees: sous COSMIC, elles
# empechaient purement et simplement le lancement de l'ecran d'accueil.
StartupNotify=false
