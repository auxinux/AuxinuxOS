#!/usr/bin/env bash
set -uo pipefail

# Accueil de la session live: choix de la langue, puis presentation.
#
# CE QUI NE FONCTIONNAIT PAS (panne rapportee: « si je choisis la langue, ca
# quitte l'interface et reste sur un ecran noir »): apres le choix, ce script
# proposait de REDEMARRER LA SESSION et executait
# `loginctl terminate-user "${USER}"`.
#
# Or la session live est ouverte par le bloc [initial_session] de greetd, qui
# ne s'applique qu'UNE SEULE FOIS, au demarrage. Une fois la session terminee,
# greetd bascule sur [default_session], c.-a-d. l'ecran de connexion. Terminer
# la session live revenait donc a se jeter hors du live sans retour: dans le
# meilleur cas un ecran de connexion pour un compte dont l'utilisateur ignore
# le mot de passe, dans le pire un ecran noir. Et tout cela pour changer une
# langue.
#
# On n'arrete plus jamais la session. La langue est appliquee:
#   * a l'environnement du gestionnaire de session utilisateur et au bus de
#     session, donc a TOUT ce qui est lance ensuite (installateur compris);
#   * dans environment.d, pour les sessions suivantes et le systeme installe.
# Ce qui est deja affiche a l'ecran (le panneau COSMIC) garde sa langue: c'est
# dit clairement a l'utilisateur plutot que paye par une deconnexion.

STATE_DIR="${HOME}/.config/auxinux"
STATE_FILE="${STATE_DIR}/welcome-seen"
CHOICE_FILE="${STATE_DIR}/language"
ENV_DIR="${HOME}/.config/environment.d"
ENV_FILE="${ENV_DIR}/60-auxinux-locale.conf"

[[ -e "${STATE_FILE}" ]] && exit 0

# Sans dialogue graphique, cet ecran n'a aucun moyen de s'afficher. On le dit
# sur stderr (visible dans le journal de session) et on sort sans bloquer le
# demarrage: l'absence d'accueil ne doit pas empecher d'utiliser le live.
if ! command -v zenity >/dev/null 2>&1; then
  echo "auxinux-welcome: zenity introuvable, accueil ignore." >&2
  exit 0
fi

mkdir -p "${STATE_DIR}" "${ENV_DIR}"

choose_language() {
  zenity --list --radiolist \
    --title "AuxiNuxOS" \
    --width 560 --height 260 \
    --text "Choisissez la langue pour poursuivre\nChoose your language" \
    --column "" --column "Langue / Language" \
    TRUE  "Francais (Canada)" \
    FALSE "English (Canada)" \
    2>/dev/null
}

locale_vars() {
  local lang="$1" primary chain
  if [[ "${lang}" == "en" ]]; then
    primary="en_CA.UTF-8"
    chain="en_CA:en:fr_CA:fr"
  else
    primary="fr_CA.UTF-8"
    chain="fr_CA:fr:en_CA:en"
  fi
  printf 'LANG=%s\nLANGUAGE=%s\nLC_TIME=%s\nLC_MONETARY=%s\nLC_PAPER=%s\nLC_MEASUREMENT=%s\n' \
    "${primary}" "${chain}" "${primary}" "${primary}" "${primary}" "${primary}"
}

write_locale() {
  # environment.d est lu au demarrage du gestionnaire de session utilisateur:
  # il couvre les sessions SUIVANTES, pas celle en cours.
  locale_vars "$1" >"${ENV_FILE}"
  chmod 0644 "${ENV_FILE}"
}

# Applique la langue a la session EN COURS, sans la redemarrer.
#
# `systemctl --user import-environment` fixe l'environnement du gestionnaire de
# session, dont heritent les unites utilisateur; `dbus-update-activation-
# environment` fait de meme pour les services actives par le bus, ce qui couvre
# les applications lancees depuis le lanceur COSMIC -- l'installateur inclus.
apply_to_running_session() {
  local line key value
  local -a keys=()
  while IFS= read -r line; do
    key="${line%%=*}"
    value="${line#*=}"
    export "${key}=${value}"
    keys+=("${key}")
  done < <(locale_vars "$1")

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment "${keys[@]}" >/dev/null 2>&1 || true
  fi
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd "${keys[@]}" >/dev/null 2>&1 || true
  fi
}

show_intro() {
  local lang="$1"
  if [[ "${lang}" == "en" ]]; then
    zenity --info --no-wrap --title "Welcome to AuxiNuxOS" --text \
"AuxiNuxOS is a Canadian desktop Linux project based on Debian and the COSMIC desktop, with a privacy-first software selection.

This live environment lets you try the system before installing it.

English is now applied to everything you open from here on, including the installer. The panel already on screen keeps its current language until the next session.

A familiar desktop, no AuxiNux telemetry, Flatpak first for applications, and DEB packages available when needed." 2>/dev/null
  else
    zenity --info --no-wrap --title "Bienvenue dans AuxiNuxOS" --text \
"AuxiNuxOS est un projet Linux de bureau canadien base sur Debian et le bureau COSMIC, avec une selection logicielle orientee vie privee.

Cet environnement live permet d'essayer le systeme avant de l'installer.

Le francais s'applique des maintenant a tout ce que vous ouvrez, installateur compris. Le panneau deja affiche garde sa langue jusqu'a la prochaine session.

Un bureau familier, aucune telemetrie AuxiNux, Flatpak en priorite pour les applications, et les paquets DEB disponibles au besoin." 2>/dev/null
  fi
}

if [[ -f "${CHOICE_FILE}" ]]; then
  selected="$(cat "${CHOICE_FILE}")"
else
  case "$(choose_language)" in
    English*) selected="en" ;;
    # Fermeture de la fenetre comprise: le francais est la langue par defaut
    # de la distribution.
    *) selected="fr" ;;
  esac
  printf '%s\n' "${selected}" >"${CHOICE_FILE}"
fi

write_locale "${selected}"
apply_to_running_session "${selected}"

show_intro "${selected}"
date -u +"%Y-%m-%dT%H:%M:%SZ" >"${STATE_FILE}"
