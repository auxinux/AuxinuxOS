#!/usr/bin/env bash
set -uo pipefail

# Accueil de la session live: choix de la langue, puis presentation.
#
# CE QUI NE FONCTIONNAIT PAS: ce script pilotait `kdialog` et ecrivait des
# fichiers de configuration Plasma (plasma-localerc, plasma-workspace/env).
# kdialog venait de Plasma, qui n'est plus installe depuis le passage a
# COSMIC: le script retombait sur une lecture au clavier, sans terminal
# attache. En session graphique, le PREMIER ecran de la distribution
# n'affichait donc rien du tout, et la langue n'etait jamais appliquee.
#
# Tout passe desormais par zenity (present dans l'image, GTK, fonctionne sous
# Wayland) et par environment.d, qui est le mecanisme d'environnement des
# sessions COSMIC.

STATE_DIR="${HOME}/.config/auxinux"
STATE_FILE="${STATE_DIR}/welcome-seen"
CHOICE_FILE="${STATE_DIR}/language"
RESTART_FILE="${STATE_DIR}/session-restarted"
ENV_DIR="${HOME}/.config/environment.d"
ENV_FILE="${ENV_DIR}/60-auxinux-locale.conf"

[[ -e "${STATE_FILE}" ]] && exit 0

# Sans dialogue graphique, cet ecran n'a aucun moyen de s'afficher. On le dit
# sur stderr (visible dans le journal de session) et on sort sans bloquer le
# demarrage: l'absence d'accueil ne doit pas empecher d'utiliser le live.
if ! command -v zenity >/dev/null 2>&1; then
  echo "auxinux-welcome: zenity introuvable, accueil ignore." >&2
  exit 0
fi

mkdir -p "${STATE_DIR}" "${ENV_DIR}"

choose_language() {
  zenity --list --radiolist \
    --title "AuxiNuxOS" \
    --width 560 --height 260 \
    --text "Choisissez la langue pour poursuivre\nChoose your language" \
    --column "" --column "Langue / Language" \
    TRUE  "Francais (Canada)" \
    FALSE "English (Canada)" \
    2>/dev/null
}

write_locale() {
  local lang="$1" primary chain
  if [[ "${lang}" == "en" ]]; then
    primary="en_CA.UTF-8"
    chain="en_CA:en:fr_CA:fr"
  else
    primary="fr_CA.UTF-8"
    chain="fr_CA:fr:en_CA:en"
  fi

  # environment.d est lu par le gestionnaire de session utilisateur, qui
  # transmet ces variables a COSMIC et a toutes les applications lancees
  # depuis le bureau.
  cat >"${ENV_FILE}" <<EOF
LANG=${primary}
LANGUAGE=${chain}
LC_TIME=${primary}
LC_MONETARY=${primary}
LC_PAPER=${primary}
LC_MEASUREMENT=${primary}
EOF
  chmod 0644 "${ENV_FILE}"
}

restart_session() {
  local lang="$1" message
  if [[ "${lang}" == "en" ]]; then
    message="The live session will restart once so the whole interface switches to English."
  else
    message="La session live va redemarrer une seule fois pour appliquer le francais a toute l'interface."
  fi

  if ! zenity --question --no-wrap --title "AuxiNuxOS" \
       --ok-label "Redemarrer / Restart" --cancel-label "Plus tard / Later" \
       --text "${message}" 2>/dev/null; then
    return 1
  fi

  touch "${RESTART_FILE}"
  if command -v loginctl >/dev/null 2>&1; then
    (sleep 1; loginctl terminate-user "${USER}") >/dev/null 2>&1 &
    exit 0
  fi
  return 1
}

show_intro() {
  local lang="$1"
  if [[ "${lang}" == "en" ]]; then
    zenity --info --no-wrap --title "Welcome to AuxiNuxOS" --text \
"AuxiNuxOS is a Canadian desktop Linux project based on Debian and the COSMIC desktop, with a privacy-first software selection.

This live environment lets you try the system before installing it.

A familiar desktop, no AuxiNux telemetry, Flatpak first for applications, and DEB packages available when needed." 2>/dev/null
  else
    zenity --info --no-wrap --title "Bienvenue dans AuxiNuxOS" --text \
"AuxiNuxOS est un projet Linux de bureau canadien base sur Debian et le bureau COSMIC, avec une selection logicielle orientee vie privee.

Cet environnement live permet d'essayer le systeme avant de l'installer.

Un bureau familier, aucune telemetrie AuxiNux, Flatpak en priorite pour les applications, et les paquets DEB disponibles au besoin." 2>/dev/null
  fi
}

if [[ -f "${CHOICE_FILE}" ]]; then
  selected="$(cat "${CHOICE_FILE}")"
else
  case "$(choose_language)" in
    English*) selected="en" ;;
    # Fermeture de la fenetre comprise: le francais est la langue par defaut
    # de la distribution.
    *) selected="fr" ;;
  esac
  printf '%s\n' "${selected}" >"${CHOICE_FILE}"
fi

write_locale "${selected}"

desired_lang="fr_CA.UTF-8"
[[ "${selected}" == "en" ]] && desired_lang="en_CA.UTF-8"

if [[ ! -f "${RESTART_FILE}" && "${LANG:-}" != "${desired_lang}" ]]; then
  restart_session "${selected}" || true
fi

show_intro "${selected}"
date -u +"%Y-%m-%dT%H:%M:%SZ" >"${STATE_FILE}"
