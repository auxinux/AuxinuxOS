#!/bin/sh
# Lance l'installateur Calamares depuis la session live (Wayland).
#
# Le wrapper Debian `calamares-install-debian` a ete ecrit pour X11: il fait
# `pkexec calamares` et ouvre l'acces avec `xhost`. Sous Wayland cela echoue EN
# SILENCE -- pkexec nettoie l'environnement, donc Calamares demarre en root
# sans DISPLAY ni WAYLAND_DISPLAY et n'affiche jamais de fenetre (« l'icone ne
# fait rien quand on clique »). A la place:
#   * Calamares passe par Xwayland (QT_QPA_PLATFORM=xcb), fourni par le
#     compositeur (KWin depuis la 0.2.0). Xwayland plutot que Wayland natif
#     parce qu'une application graphique en root sur Wayland demande de lui
#     passer WAYLAND_DISPLAY et XDG_RUNTIME_DIR, ce qui est nettement plus
#     fragile;
#   * l'elevation passe par sudo -- le compte live a sudo sans mot de passe,
#     donc aucun agent polkit n'est requis, y compris si le bureau change;
#   * DISPLAY est transmis et l'acces au serveur X accorde au seul compte root.
set -eu

export QT_AUTO_SCREEN_SCALE_FACTOR=1

# KWin demarre Xwayland paresseusement; DISPLAY vaut normalement :0.
DISPLAY="${DISPLAY:-:0}"
export DISPLAY

# Langue choisie dans l'ecran d'accueil (auxinux-welcome). C'est le seul effet
# visible qu'attend l'utilisateur apres ce choix: l'installateur doit s'ouvrir
# dans SA langue. L'accueil ne redemarre plus la session pour l'obtenir, donc
# la valeur est relue ici et transmise explicitement a Calamares.
CHOICE_FILE="${HOME}/.config/auxinux/language"
if [ -r "${CHOICE_FILE}" ]; then
    if [ "$(cat "${CHOICE_FILE}")" = "en" ]; then
        LANG=en_CA.UTF-8
        LANGUAGE=en_CA:en:fr_CA:fr
    else
        LANG=fr_CA.UTF-8
        LANGUAGE=fr_CA:fr:en_CA:en
    fi
    export LANG LANGUAGE
fi

# Controle de la configuration requise AVANT d'ouvrir l'installateur.
#
# La regle demandee: sous le minimum (4 Go de RAM, 2 coeurs, 40 Go de disque),
# on BLOQUE. Mieux vaut le dire ici qu'apres quarante minutes d'installation.
#
# SECURITE POSITIVE: on ne bloque que sur un verdict EXPLICITE (code 1 et
# message correspondant). Si auxinux-hwcheck est absent, plante, ou repond
# autre chose, l'installation continue. Un defaut de l'outil de controle ne
# doit jamais rendre une ISO inutilisable -- c'est le controle qui est
# accessoire, pas l'installation.
if command -v auxinux-hwcheck >/dev/null 2>&1; then
    HW_REPORT="$(auxinux-hwcheck 2>/dev/null)" || HW_RC=$?
    HW_RC="${HW_RC:-0}"
    if [ "${HW_RC}" = "1" ] && printf '%s' "${HW_REPORT}" | grep -q 'INSTALLATION IMPOSSIBLE'; then
        zenity --error --no-wrap --title "AuxiNuxOS — configuration insuffisante"             --text "Cette machine n'atteint pas la configuration minimale requise.

${HW_REPORT}

Vous pouvez continuer a utiliser le systeme live, mais l'installation est
bloquee pour eviter un systeme installe inutilisable." 2>/dev/null             || echo "${HW_REPORT}" >&2
        exit 1
    fi
fi

# Make sure an X server is actually answering before we grant access and
# elevate; otherwise tell the user instead of failing invisibly.
if ! xset q >/dev/null 2>&1; then
    # Give Xwayland a moment in case the session just started.
    sleep 2
    if ! xset q >/dev/null 2>&1; then
        notify-send "Installateur AuxiNuxOS" \
            "Impossible de joindre l'affichage graphique (Xwayland)." 2>/dev/null || true
        echo "no X display available (Xwayland)" >&2
        exit 1
    fi
fi

# Stale fstab left by live-boot confuses Calamares partitioning.
#
# La restauration passe par un trap et non par une derniere ligne du script:
# l'utilisateur termine normalement l'installation en cliquant « Redemarrer
# maintenant », ce qui tue ce script sur place. La ligne finale n'etait donc
# jamais atteinte, et le live restait sans /etc/fstab -- sans consequence sur
# un systeme jetable, mais un lancement ulterieur de l'installateur trouvait
# une sauvegarde bidon a restaurer.
FSTAB_MOVED=0
restore_fstab() {
    [ "${FSTAB_MOVED}" -eq 1 ] || return 0
    sudo mv /etc/fstab.orig.calamares /etc/fstab 2>/dev/null || true
    FSTAB_MOVED=0
}
trap 'restore_fstab' EXIT HUP INT TERM

if [ -f /etc/fstab ]; then
    if sudo mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null; then
        FSTAB_MOVED=1
    fi
fi

# Let the root-owned Calamares process connect to our X server.
#
# The `xhost +` fallback was removed: it disables X access control entirely,
# letting ANY local process read this session's keystrokes and windows --
# including the disk password typed into the installer. Only the root user is
# granted access; if even that fails we say so instead of widening it.
if ! xhost +SI:localuser:root >/dev/null 2>&1; then
    echo "warning: could not grant X access to root (xhost)" >&2
fi

sudo -E env DISPLAY="${DISPLAY}" QT_QPA_PLATFORM=xcb \
    QT_AUTO_SCREEN_SCALE_FACTOR=1 \
    LANG="${LANG:-fr_CA.UTF-8}" LANGUAGE="${LANGUAGE:-fr_CA:fr:en_CA:en}" \
    calamares || true

xhost -SI:localuser:root >/dev/null 2>&1 || true
