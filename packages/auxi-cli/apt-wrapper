#!/usr/bin/env bash
set -euo pipefail

name="$(basename "$0")"
real="/usr/lib/auxinux/apt-real/${name}"
conf="/etc/auxinux/apt.conf"

is_english() {
  local locale_chain="${LC_ALL:-}|${LC_MESSAGES:-}|${LANGUAGE:-}|${LANG:-}"
  [[ "${locale_chain}" =~ (^|[|:])en([_.]|$) ]]
}

if [[ -r "${conf}" ]] && grep -Eq '^APT_ENABLED=1$' "${conf}"; then
  exec "${real}" "$@"
fi

if is_english; then
cat >&2 <<EOF
AuxiNux OS uses the user-facing auxi command to manage applications and packages.

Examples:
  auxi update
  auxi upgrade
  sudo auxi osupdate           (system update: every DEB package, kernels included)
  auxi kernel                  (installed and available kernels)
  auxi search firefox
  auxi install org.mozilla.firefox
  sudo auxi set deb=true       (allow DEB applications)
  sudo auxi install --deb package-name

To explicitly re-enable apt in the CLI:
  sudo auxi set apt=true
EOF
else
cat >&2 <<EOF
AuxiNux OS utilise la commande utilisateur auxi pour gérer les applications et paquets.

Exemples:
  auxi update
  auxi upgrade
  sudo auxi osupdate           (mise à jour du système: tous les paquets DEB, noyaux compris)
  auxi kernel                  (noyaux installés et disponibles)
  auxi search firefox
  auxi install org.mozilla.firefox
  sudo auxi set deb=true       (autoriser les applications DEB)
  sudo auxi install --deb nom-du-paquet

Pour réactiver explicitement apt en CLI:
  sudo auxi set apt=true
EOF
fi
exit 1
