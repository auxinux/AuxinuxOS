#!/usr/bin/env bash
set -euo pipefail

APT_CONF="/etc/auxinux/apt.conf"
# Installation d'APPLICATIONS en DEB (Center et `auxi install` sans option).
# Distinct d'APT_CONF: on peut vouloir des applications DEB tout en gardant
# apt/apt-get renvoyes vers auxi et son point de restauration.
APPS_CONF="/etc/auxinux/apps.conf"
APT_REAL_DIR="/usr/lib/auxinux/apt-real"
SNAPPER_CONFIG="root"
BTRFS_TOPLEVEL_MNT="/run/auxinux-btrfs-toplevel"
SNAPSHOT_OVERLAY_LOWER="/run/auxinux-snapshot/lower"

is_english() {
  local locale_chain="${LC_ALL:-}|${LC_MESSAGES:-}|${LANGUAGE:-}|${LANG:-}"
  [[ "${locale_chain}" =~ (^|[|:])en([_.]|$) ]]
}

say() {
  local fr="$1"
  local en="$2"
  if is_english; then
    printf '%s\n' "${en}"
  else
    printf '%s\n' "${fr}"
  fi
}

say_err() {
  local fr="$1"
  local en="$2"
  if is_english; then
    printf '%s\n' "${en}" >&2
  else
    printf '%s\n' "${fr}" >&2
  fi
}

usage() {
  if is_english; then
    cat <<'EOF'
auxi - AuxiNux OS administration command

Usage:
  auxi [--yes] [--progress] COMMAND ...
  auxi update [--deb|--flatpak]
  auxi upgrade [--deb|--flatpak]
  auxi search [--deb|--flatpak] TERM
  auxi install [--deb|--flatpak] PACKAGE_OR_APP...
  auxi uninstall [--deb|--flatpak] PACKAGE_OR_APP
  auxi purge PACKAGE
  auxi clean
  auxi autoclean
  auxi snapshot [DESCRIPTION]
  auxi snapshots
  auxi rollback [NUMBER] [--yes]
  auxi rollback-cleanup [--yes]
  auxi set apt=true|false
  auxi set deb=true|false
  auxi status

Applications are installed from Flatpak (Flathub). DEB installation is only
used when enabled (auxi set deb=true), and even then only when no Flatpak
exists for the requested application.

Global options (before the command):
  --yes       answer yes to every question, keep modified configuration files
  --progress  also print machine-readable progress lines (apt Status-Fd)
EOF
  else
    cat <<'EOF'
auxi - commande d'administration AuxiNux OS

Usage:
  auxi [--yes] [--progress] COMMANDE ...
  auxi update [--deb|--flatpak]
  auxi upgrade [--deb|--flatpak]
  auxi search [--deb|--flatpak] TERME
  auxi install [--deb|--flatpak] PAQUET_OU_APP...
  auxi uninstall [--deb|--flatpak] PAQUET_OU_APP
  auxi purge PAQUET
  auxi clean
  auxi autoclean
  auxi snapshot [DESCRIPTION]
  auxi snapshots
  auxi rollback [NUMERO] [--yes]
  auxi rollback-cleanup [--yes]
  auxi set apt=true|false
  auxi set deb=true|false
  auxi status

Les applications s'installent depuis Flatpak (Flathub). L'installation DEB
n'est utilisee que si elle est activee (auxi set deb=true), et meme alors
seulement quand aucun Flatpak n'existe pour l'application demandee.

Options globales (avant la commande):
  --yes       repond oui a toutes les questions, garde les fichiers de
              configuration modifies
  --progress  ajoute des lignes d'avancement lisibles par un programme
              (Status-Fd d'apt)
EOF
  fi
}

require_root_for_config() {
  if [[ "${EUID}" -ne 0 ]]; then
    say_err \
      "Cette action doit etre executee avec sudo: sudo auxi $*" \
      "This action must be run with sudo: sudo auxi $*"
    exit 1
  fi
}

require_root_for_deb() {
  if [[ "${EUID}" -ne 0 ]]; then
    say_err \
      "Les operations DEB doivent etre executees avec sudo." \
      "DEB operations must be run with sudo."
    say_err \
      "Exemple: sudo auxi $*" \
      "Example: sudo auxi $*"
    exit 1
  fi
}

apt_real() {
  # Toujours appeler le vrai binaire APT directement.
  # Ne jamais retomber sur command -v: cela resoudrait le wrapper
  # /usr/bin/apt-get qui, avec APT_ENABLED=0, bloquerait auxi lui-meme.
  local name="$1"
  if [[ -x "${APT_REAL_DIR}/${name}" ]]; then
    echo "${APT_REAL_DIR}/${name}"
  else
    say_err \
      "Binaire APT introuvable: ${APT_REAL_DIR}/${name}" \
      "APT binary not found: ${APT_REAL_DIR}/${name}"
    say_err \
      "Installation auxi incomplete; verifiez install-auxi-cli.sh." \
      "Incomplete auxi installation; check install-auxi-cli.sh."
    exit 70
  fi
}

# apt-get avec les options globales de `auxi`.
#
# --yes N'EST PAS UN CONFORT: c'est ce qui permet au centre de controle de
# mettre le systeme a jour. Il lance `auxi` par pkexec, sans terminal, l'entree
# standard sur /dev/null. Sans -y, apt-get posait sa question « Continuer ?
# [O/n] », lisait une fin de fichier, repondait « Abandon. » et sortait en 1 --
# sur la sortie STANDARD, que l'interface ne montrait pas. L'utilisateur voyait
# « Echec de l'operation » apres plusieurs minutes, sans aucune explication.
# Meme chose pour toute desinstallation, et pour toute installation qui tire
# une dependance.
#
# Sans terminal, aucune autre question ne peut recevoir de reponse non plus:
#   - debconf: frontend noninteractive, les valeurs par defaut s'appliquent;
#   - dpkg et un fichier de configuration modifie localement (c'est le cas de
#     /etc/issue, que l'image remplace): --force-confold garde la version
#     installee, --force-confdef laisse dpkg trancher seul quand il le peut.
#     Sans ces options, dpkg echoue sur « EOF on stdin at conffile prompt » au
#     milieu de la transaction.
#
# --progress ajoute les lignes « dlstatus: » et « pmstatus: » d'apt sur la
# sortie standard (pkexec ferme tout descripteur au-dela de 2, d'ou le 1).
# C'est ce que le centre de controle lit pour afficher sa barre de progression.
apt_get() {
  local bin
  bin="$(apt_real apt-get)"
  local opts=()
  if [[ "${ASSUME_YES}" -eq 1 ]]; then
    opts+=(-y -o "Dpkg::Options::=--force-confdef" -o "Dpkg::Options::=--force-confold")
  fi
  if [[ "${PROGRESS}" -eq 1 ]]; then
    opts+=(-o "APT::Status-Fd=1")
  fi
  "${bin}" "${opts[@]}" "$@"
}

# Options communes de flatpak: -y en toutes circonstances (c'etait deja le cas),
# et une sortie sans tableau anime quand personne n'est la pour la lire.
flatpak_opts() {
  FLATPAK_OPTS=(-y)
  if [[ "${ASSUME_YES}" -eq 1 ]]; then
    FLATPAK_OPTS+=(--noninteractive)
  fi
}

apt_enabled() {
  [[ -r "${APT_CONF}" ]] && grep -Eq '^APT_ENABLED=1$' "${APT_CONF}"
}

deb_apps_enabled() {
  [[ -r "${APPS_CONF}" ]] && grep -Eq '^DEB_APPS=1$' "${APPS_CONF}"
}

set_deb_apps() {
  require_root_for_config set "deb=$1"
  install -d -m 0755 /etc/auxinux
  case "$1" in
    true|1|yes)
      printf 'DEB_APPS=1\n' >"${APPS_CONF}"
      say \
        "Installation DEB activee. Flatpak reste prioritaire: le DEB ne sert que si aucun Flatpak n'existe." \
        "DEB installation enabled. Flatpak stays first: DEB is used only when no Flatpak exists."
      ;;
    false|0|no)
      printf 'DEB_APPS=0\n' >"${APPS_CONF}"
      say \
        "Installation DEB desactivee: les applications s'installent depuis Flatpak." \
        "DEB installation disabled: applications are installed from Flatpak."
      ;;
    *)
      say_err "Valeur invalide: deb=$1" "Invalid value: deb=$1"
      exit 64
      ;;
  esac
}

deb_installed() {
  dpkg-query -W -f='${Status}' -- "$1" 2>/dev/null | grep -q 'install ok installed'
}

deb_disabled_hint() {
  say_err \
    "L'installation DEB est desactivee. Pour l'activer: sudo auxi set deb=true (ou Reglages du centre AuxiNux)." \
    "DEB installation is disabled. To enable it: sudo auxi set deb=true (or the AuxiNux Center settings)."
}

# Forme comparable d'un nom: minuscules, lettres et chiffres seulement.
# « OBS Studio », « obs-studio » et « obsstudio » se rejoignent.
normalize_name() {
  local s="${1,,}"
  printf '%s' "${s//[^a-z0-9]/}"
}

# Identifiant Flathub d'une application demandee par son nom.
#
# `auxi install gimp` installait le DEB: seul un identifiant EXACT
# (org.gimp.GIMP) etait reconnu comme Flatpak. On accepte desormais, sans
# tenir compte de la casse ni des tirets: l'identifiant complet, son dernier
# composant (org.gimp.GIMP -> gimp) ou le nom affiche (« OBS Studio »). Les
# greffons (org.gimp.GIMP.Plugin.*) et manuels ne correspondent pas: leur
# dernier composant et leur nom different. Rien n'est devine au-dela: sans
# correspondance exacte, aucune application n'est choisie a la place de
# l'utilisateur.
#
# $1: terme demande; lit la sortie de `flatpak search --columns=
# application,name,remotes` sur l'entree standard.
pick_flatpak_id() {
  local want id name remotes tail
  want="$(normalize_name "$1")"
  [[ -n "${want}" ]] || return 1
  while IFS=$'\t' read -r id name remotes; do
    [[ "${id}" == *.* ]] || continue
    [[ ",${remotes// /}," == *,flathub,* ]] || continue
    tail="${id##*.}"
    if [[ "$(normalize_name "${id}")" == "${want}" \
          || "$(normalize_name "${tail}")" == "${want}" \
          || "$(normalize_name "${name}")" == "${want}" ]]; then
      printf '%s\n' "${id}"
      return 0
    fi
  done
  return 1
}

resolve_flatpak() {
  local term="$1"
  if flatpak remote-ls flathub --app --columns=application 2>/dev/null | grep -Fxq -- "${term}"; then
    printf '%s\n' "${term}"
    return 0
  fi
  flatpak search --columns=application,name,remotes -- "${term}" 2>/dev/null \
    | pick_flatpak_id "${term}"
}

# Applications Flathub proches de $1, quand aucune ne correspond exactement.
show_flatpak_suggestions() {
  local shown=0 id name remotes
  while IFS=$'\t' read -r id name remotes; do
    [[ "${id}" == *.* && ",${remotes// /}," == *,flathub,* ]] || continue
    [[ "${shown}" -eq 0 ]] && say "Applications Flatpak proches:" "Close Flatpak applications:"
    printf '  %-40s %s\n' "${id}" "${name}"
    shown=$((shown + 1))
    [[ "${shown}" -ge 8 ]] && break
  done < <(flatpak search --columns=application,name,remotes -- "$1" 2>/dev/null || true)
  if [[ "${shown}" -gt 0 ]]; then
    say "Installez-en une par son identifiant: auxi install IDENTIFIANT" \
        "Install one by its identifier: auxi install IDENTIFIER"
  fi
}

set_apt() {
  require_root_for_config set "apt=$1"
  install -d -m 0755 /etc/auxinux
  case "$1" in
    true|1|yes)
      printf 'APT_ENABLED=1\n' >"${APT_CONF}"
      say \
        "APT direct reactive. La commande recommandee reste auxi." \
        "Direct APT re-enabled. The recommended command remains auxi."
      ;;
    false|0|no)
      printf 'APT_ENABLED=0\n' >"${APT_CONF}"
      say \
        "APT direct masque. Utilisez auxi pour les operations utilisateur." \
        "Direct APT hidden. Use auxi for user package operations."
      ;;
    *)
      say_err \
        "Valeur invalide: apt=$1" \
        "Invalid value: apt=$1"
      exit 64
      ;;
  esac
}

# --- Instantanes systeme (BTRFS + snapper) ---------------------------------
#
# Tout ce bloc doit se degrader silencieusement: une racine ext4, un snapper
# absent ou une session live n'ont pas d'instantanes, et cela ne doit JAMAIS
# empecher une installation de paquet d'aboutir.

# Vrai quand le systeme a demarre sur un instantane depuis le menu GRUB. Dans
# ce cas la racine visible est un overlay (voir le hook initramfs
# auxinux-snapshot-overlay): interroger "/" renverrait « overlay » et le nom de
# peripherique « auxinux-snapshot ». C'est PRECISEMENT la situation ou l'on a
# besoin de `auxi rollback`, et sans cette distinction la commande refusait de
# s'executer.
booted_from_snapshot() {
  [[ -d "${SNAPSHOT_OVERLAY_LOWER}" ]] || return 1
  grep -qw 'auxinux.snapshot=1' /proc/cmdline 2>/dev/null
}

# Point de montage a interroger pour connaitre le VRAI systeme de fichiers
# racine, instantane compris.
root_mount_ref() {
  if booted_from_snapshot; then
    printf '%s' "${SNAPSHOT_OVERLAY_LOWER}"
  else
    printf '/'
  fi
}

snapshots_available() {
  command -v snapper >/dev/null 2>&1 || return 1
  [[ "$(findmnt -no FSTYPE "$(root_mount_ref)" 2>/dev/null)" == "btrfs" ]] || return 1
  [[ -f "/etc/snapper/configs/${SNAPPER_CONFIG}" ]] || return 1
  return 0
}

require_snapshots() {
  if snapshots_available; then
    return 0
  fi
  say_err \
    "Les instantanes ne sont pas disponibles sur ce systeme." \
    "Snapshots are not available on this system."
  say_err \
    "Ils exigent une racine BTRFS avec snapper configure (voir docs/rollback.md)." \
    "They require a BTRFS root with snapper configured (see docs/rollback.md)."
  exit 69
}

# Les instantanes automatiques ne sont PLUS poses ici.
#
# Ils le sont par /usr/lib/auxinux/apt-snapshot-hook, branche sur DPkg::Pre-
# Invoke et DPkg::Post-Invoke (voir /etc/apt/apt.conf.d/80auxinux-snapshot).
# Tant que la logique vivait dans `auxi`, toute autre voie vers dpkg -- `apt`
# reactive par `auxi set apt=true`, PackageKit, un script tiers -- modifiait le
# systeme sans filet, alors que l'interface affirmait le contraire. Attache a
# dpkg, l'instantane couvre desormais tous les chemins, `auxi` compris: le
# dupliquer ici produirait deux paires pre/post par transaction.
#
# AUXI_NO_SNAPSHOT=1 reste honore: le hook lit la meme variable, transmise par
# l'environnement jusqu'a apt-get.

run_snapshot() {
  require_snapshots
  require_root_for_config snapshot "$@"
  local description="${*:-Instantane manuel}"
  local number
  number="$(snapper -c "${SNAPPER_CONFIG}" create \
    --type single --print-number --cleanup-algorithm number \
    --description "${description}" \
    --userdata "auxi=1")"
  say \
    "Instantane ${number} cree: ${description}" \
    "Snapshot ${number} created: ${description}"
}

run_snapshot_list() {
  require_snapshots
  snapper -c "${SNAPPER_CONFIG}" list
}

# Restauration. Sur une disposition plate "@" (la notre), `snapper rollback`
# ne suffit PAS: il joue sur le sous-volume par defaut, alors que /etc/fstab
# monte la racine par CHEMIN (subvol=@). On echange donc les sous-volumes.
#
# L'operation est sure depuis un systeme en cours d'execution: renommer un
# sous-volume monte n'affecte pas le montage courant, et c'est au prochain
# demarrage que subvol=@ resout vers le sous-volume restaure.
# Etat de la protection au demarrage DANS le systeme restaure.
#
# PANNE DU 2026-10-04 (rapportee par aporler): le compteur de demarrages rates
# vit dans /var/lib/auxinux, donc DANS la racine -- il est restaure avec elle.
# Un instantane pris pendant un demarrage (snapper-boot, une seconde apres
# l'allumage) contient un compteur deja incremente: le restaurer faisait croire
# a un bureau en panne au demarrage suivant, la console de secours restaurait a
# son tour le dernier instantane... pris pendant ce demarrage rate, et ainsi de
# suite, sans fin. Remettre le compteur a zero ICI, et non dans le systeme en
# cours (qui est l'ancien), est ce qui casse la boucle.
#
# last-restore: numero restaure, lu par auxinux-rescue pour ne jamais
# restaurer deux fois de suite automatiquement le meme instantane.
reset_boot_state() {
  local root="$1" number="$2"
  local dir="${root}/var/lib/auxinux"
  mkdir -p "${dir}" 2>/dev/null || return 0
  printf '0\n' >"${dir}/boot-failures" 2>/dev/null || true
  printf '%s\n' "${number}" >"${dir}/last-restore" 2>/dev/null || true
}

run_rollback() {
  require_snapshots
  require_root_for_config rollback "$@"

  local assume_yes=0
  local number=""
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --yes|-y) assume_yes=1 ;;
      *) number="${arg}" ;;
    esac
  done

  if [[ -z "${number}" ]]; then
    run_snapshot_list
    say \
      "Choisissez un numero, puis: sudo auxi rollback NUMERO" \
      "Pick a number, then run: sudo auxi rollback NUMBER"
    return 0
  fi

  if [[ ! "${number}" =~ ^[0-9]+$ ]]; then
    say_err "Numero d'instantane invalide: ${number}" "Invalid snapshot number: ${number}"
    exit 64
  fi

  local root_source root_device
  root_source="$(findmnt -no SOURCE "$(root_mount_ref)" 2>/dev/null || true)"
  # findmnt rend "/dev/sda2[/@]" sur un sous-volume: on retire le suffixe.
  root_device="${root_source%%\[*}"
  if [[ -z "${root_device}" ]]; then
    say_err "Peripherique racine introuvable." "Could not determine root device."
    exit 69
  fi

  mkdir -p "${BTRFS_TOPLEVEL_MNT}"
  if ! mount -o subvolid=5 "${root_device}" "${BTRFS_TOPLEVEL_MNT}"; then
    say_err \
      "Montage de la racine BTRFS impossible: ${root_device}" \
      "Could not mount the BTRFS top level: ${root_device}"
    exit 69
  fi
  trap auxi_rollback_cleanup EXIT

  # @snapshots est un sous-volume de premier niveau (voir mount.conf); on
  # accepte quand meme la disposition imbriquee des installations anciennes.
  local snapshot_src=""
  local candidate
  for candidate in \
    "${BTRFS_TOPLEVEL_MNT}/@snapshots/${number}/snapshot" \
    "${BTRFS_TOPLEVEL_MNT}/@/.snapshots/${number}/snapshot"; do
    if [[ -d "${candidate}" ]]; then
      snapshot_src="${candidate}"
      break
    fi
  done

  if [[ -z "${snapshot_src}" ]]; then
    say_err "Instantane ${number} introuvable." "Snapshot ${number} not found."
    exit 69
  fi

  local stamp saved
  stamp="$(date +%Y%m%d-%H%M%S)"
  saved="@.rollback-${stamp}"

  say \
    "Restauration de l'instantane ${number}." \
    "Restoring snapshot ${number}."
  say \
    "Le systeme actuel est conserve sous ${saved} et /home n'est pas touche." \
    "The current system is kept as ${saved} and /home is left untouched."
  say \
    "Le changement prend effet au prochain demarrage." \
    "The change takes effect on next boot."

  if [[ "${assume_yes}" -ne 1 ]]; then
    local answer
    say "Confirmer? [o/N]" "Confirm? [y/N]"
    read -r answer
    case "${answer}" in
      o|O|oui|OUI|y|Y|yes|YES) ;;
      *)
        say "Restauration annulee." "Rollback cancelled."
        return 0
        ;;
    esac
  fi

  if ! mv "${BTRFS_TOPLEVEL_MNT}/@" "${BTRFS_TOPLEVEL_MNT}/${saved}"; then
    say_err \
      "Mise de cote du systeme actuel impossible; rien n'a ete modifie." \
      "Could not move the current system aside; nothing was changed."
    exit 69
  fi

  if ! btrfs subvolume snapshot "${snapshot_src}" "${BTRFS_TOPLEVEL_MNT}/@"; then
    # Sans cette remise en place, la machine n'aurait plus AUCUNE racine "@"
    # et ne redemarrerait pas. C'est le seul point vraiment dangereux.
    mv "${BTRFS_TOPLEVEL_MNT}/${saved}" "${BTRFS_TOPLEVEL_MNT}/@" || true
    say_err \
      "Restauration echouee; le systeme d'origine a ete remis en place." \
      "Rollback failed; the original system has been restored."
    exit 69
  fi

  reset_boot_state "${BTRFS_TOPLEVEL_MNT}/@" "${number}"

  say \
    "Restauration prete. Redemarrez pour l'appliquer: sudo reboot" \
    "Rollback ready. Reboot to apply it: sudo reboot"
  say \
    "Ancien systeme conserve sous le sous-volume ${saved}." \
    "Previous system kept as subvolume ${saved}."
  say \
    "Une fois le redemarrage valide, vous pouvez le supprimer:" \
    "Once the reboot is confirmed working, you can delete it:"
  printf '  sudo auxi rollback-cleanup\n'
}

# Suppression des systemes mis de cote par une restauration.
#
# `auxi rollback` conserve DELIBEREMENT l'ancien systeme sous @.rollback-<date>
# -- c'est le seul recours si la restauration s'avere pire que la panne. Mais
# rien ne les supprimait ensuite: chaque restauration laissait une copie
# complete du systeme sur le disque, jusqu'a saturation. La suppression reste
# manuelle et explicite; elle cesse simplement d'exiger trois commandes
# recopiees a la main.
run_rollback_cleanup() {
  require_root_for_config rollback-cleanup "$@"

  local assume_yes=0 arg
  for arg in "$@"; do
    case "${arg}" in
      --yes|-y) assume_yes=1 ;;
    esac
  done

  local root_source root_device
  root_source="$(findmnt -no SOURCE "$(root_mount_ref)" 2>/dev/null || true)"
  root_device="${root_source%%\[*}"
  if [[ -z "${root_device}" ]]; then
    say_err "Peripherique racine introuvable." "Could not determine root device."
    exit 69
  fi

  mkdir -p "${BTRFS_TOPLEVEL_MNT}"
  if ! mount -o subvolid=5 "${root_device}" "${BTRFS_TOPLEVEL_MNT}"; then
    say_err \
      "Montage de la racine BTRFS impossible: ${root_device}" \
      "Could not mount the BTRFS top level: ${root_device}"
    exit 69
  fi
  trap auxi_rollback_cleanup EXIT

  local saved=()
  local candidate
  for candidate in "${BTRFS_TOPLEVEL_MNT}"/@.rollback-*; do
    [[ -d "${candidate}" ]] || continue
    saved+=("${candidate}")
  done

  if [[ "${#saved[@]}" -eq 0 ]]; then
    say \
      "Aucun systeme mis de cote par une restauration." \
      "No system set aside by a rollback."
    return 0
  fi

  say \
    "Systemes conserves par une restauration precedente:" \
    "Systems kept by a previous rollback:"
  for candidate in "${saved[@]}"; do
    printf '  %s\n' "$(basename "${candidate}")"
  done
  say \
    "Ne les supprimez qu'apres avoir verifie que le systeme restaure demarre." \
    "Only delete these once you have confirmed the restored system boots."

  if [[ "${assume_yes}" -ne 1 ]]; then
    local answer
    say "Supprimer definitivement? [o/N]" "Delete permanently? [y/N]"
    read -r answer
    case "${answer}" in
      o|O|oui|OUI|y|Y|yes|YES) ;;
      *)
        say "Suppression annulee." "Deletion cancelled."
        return 0
        ;;
    esac
  fi

  local failures=0
  for candidate in "${saved[@]}"; do
    if btrfs subvolume delete "${candidate}" >/dev/null 2>&1; then
      say "Supprime: $(basename "${candidate}")" "Deleted: $(basename "${candidate}")"
    else
      failures=$((failures + 1))
      say_err \
        "Suppression impossible: $(basename "${candidate}")" \
        "Could not delete: $(basename "${candidate}")"
    fi
  done
  [[ "${failures}" -eq 0 ]] || exit 69
}

auxi_rollback_cleanup() {
  umount "${BTRFS_TOPLEVEL_MNT}" >/dev/null 2>&1 || true
  rmdir "${BTRFS_TOPLEVEL_MNT}" >/dev/null 2>&1 || true
}

select_mode() {
  MODE="both"
  if [[ "${1:-}" == "--deb" ]]; then
    MODE="deb"
    shift
  elif [[ "${1:-}" == "--flatpak" ]]; then
    MODE="flatpak"
    shift
  fi
  ARGS=("$@")
}

run_update() {
  select_mode "$@"
  flatpak_opts
  if [[ "${MODE}" == "both" || "${MODE}" == "flatpak" ]]; then
    flatpak update --appstream "${FLATPAK_OPTS[@]}" || true
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "deb" ]]; then
    require_root_for_deb update "$@"
    apt_get update
  fi
}

run_upgrade() {
  select_mode "$@"
  flatpak_opts
  local failed=0
  if [[ "${MODE}" == "both" || "${MODE}" == "flatpak" ]]; then
    # Un echec Flatpak (Flathub injoignable, runtime retire) ne doit pas priver
    # le systeme de ses correctifs de securite DEB: on continue, et l'echec est
    # rendu a la fin. Avant, `set -e` arretait tout ici.
    if ! flatpak update "${FLATPAK_OPTS[@]}"; then
      failed=1
      say_err \
        "La mise a jour des applications Flatpak a echoue; les paquets systeme sont mis a jour quand meme." \
        "Flatpak application update failed; system packages are updated anyway."
    fi
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "deb" ]]; then
    require_root_for_deb upgrade "$@"
    apt_get upgrade
  fi
  return "${failed}"
}

run_search() {
  select_mode "$@"
  local term="${ARGS[0]:-}"
  if [[ -z "${term}" ]]; then
    say_err "Recherche manquante." "Missing search term."
    exit 64
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "flatpak" ]]; then
    echo "== Flatpak =="
    flatpak search -- "${term}" || true
  fi
  # Sans --deb, les paquets DEB ne sont proposes que si leur installation est
  # activee: ailleurs, on les listerait sans pouvoir les installer.
  if [[ "${MODE}" == "deb" ]] || { [[ "${MODE}" == "both" ]] && deb_apps_enabled; }; then
    echo "== DEB =="
    "$(apt_real apt-cache)" search -- "${term}" || true
  fi
}

run_install() {
  select_mode "$@"
  local item="${ARGS[0]:-}"
  if [[ -z "${item}" ]]; then
    say_err \
      "Element a installer manquant." \
      "Missing package or application to install."
    exit 64
  fi
  flatpak_opts
  # Avec --flatpak ou --deb, PLUSIEURS elements sont acceptes: l'assistant de
  # premier demarrage installe toute une selection en une seule transaction
  # (une seule autorisation, un seul instantane). --or-update: une
  # application deja presente est mise a jour au lieu de faire echouer le
  # lot -- c'est le cas quand on relance l'assistant.
  if [[ "${MODE}" == "flatpak" ]]; then
    flatpak install "${FLATPAK_OPTS[@]}" --or-update flathub -- "${ARGS[@]}"
  elif [[ "${MODE}" == "deb" ]]; then
    # --deb explicite: un paquet NOUVEAU est refuse tant que l'installation DEB
    # n'est pas activee. Un paquet deja installe passe: c'est ainsi que le
    # centre met a jour une application DEB (AuxiNux Office), et pkexec ne
    # transmet aucune variable d'environnement. L'assistant de premier
    # demarrage, qui installe ses propres paquets (Brave, depuis son depot),
    # passe AUXI_DEB_SYSTEME=1.
    if ! deb_apps_enabled && [[ "${AUXI_DEB_SYSTEME:-0}" != "1" ]]; then
      local pkg
      for pkg in "${ARGS[@]}"; do
        if ! deb_installed "${pkg}"; then
          say_err "Paquet DEB non installe: ${pkg}" "DEB package not installed: ${pkg}"
          deb_disabled_hint
          exit 1
        fi
      done
    fi
    require_root_for_deb install "$@"
    apt_get install -- "${ARGS[@]}"
  else
    # Flatpak TOUJOURS d'abord; le DEB seulement si aucun Flatpak ne
    # correspond, et seulement si l'installation DEB est activee.
    local id
    for item in "${ARGS[@]}"; do
      if id="$(resolve_flatpak "${item}")"; then
        [[ "${id}" != "${item}" ]] && say \
          "${item}: application Flatpak ${id}" \
          "${item}: Flatpak application ${id}"
        flatpak install "${FLATPAK_OPTS[@]}" flathub -- "${id}"
      elif deb_apps_enabled; then
        say \
          "Aucun Flatpak trouve pour ${item}; installation DEB." \
          "No Flatpak found for ${item}; using DEB installation."
        require_root_for_deb install "${item}"
        apt_get install -- "${item}"
      else
        say_err \
          "Aucune application Flatpak nommee ${item}." \
          "No Flatpak application named ${item}."
        show_flatpak_suggestions "${item}"
        deb_disabled_hint
        exit 1
      fi
    done
  fi
}

run_uninstall() {
  select_mode "$@"
  local item="${ARGS[0]:-}"
  if [[ -z "${item}" ]]; then
    say_err \
      "Element a desinstaller manquant." \
      "Missing package or application to uninstall."
    exit 64
  fi
  flatpak_opts
  if [[ "${MODE}" == "flatpak" ]]; then
    flatpak uninstall "${FLATPAK_OPTS[@]}" -- "${item}"
  elif [[ "${MODE}" == "deb" ]]; then
    require_root_for_deb uninstall "$@"
    apt_get remove -- "${item}"
  else
    require_root_for_deb uninstall "$@"
    # Une desinstallation Flatpak ne modifie pas l'etat systeme capture par
    # "@": aucun instantane n'est pose tant qu'on ne retombe pas sur DEB, ce
    # dont le hook dpkg se charge desormais.
    if ! flatpak uninstall "${FLATPAK_OPTS[@]}" -- "${item}"; then
      apt_get remove -- "${item}"
    fi
  fi
}

# Options globales, AVANT la commande. Elles ne sont pas cherchees dans le
# reste de la ligne: `auxi rollback N --yes` a deja son propre --yes, qui
# confirme une restauration -- un sens different qu'il ne faut pas capter ici.
ASSUME_YES=0
PROGRESS=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes|-y) ASSUME_YES=1; shift ;;
    --progress) PROGRESS=1; shift ;;
    *) break ;;
  esac
done
if [[ "${ASSUME_YES}" -eq 1 ]]; then
  export DEBIAN_FRONTEND=noninteractive
fi

case "${1:-}" in
  update)
    shift; run_update "$@"
    ;;
  upgrade)
    shift; run_upgrade "$@"
    ;;
  search)
    shift; run_search "$@"
    ;;
  install)
    shift; run_install "$@"
    ;;
  uninstall|remove)
    shift; run_uninstall "$@"
    ;;
  purge)
    shift
    require_root_for_deb purge "$@"
    apt_get purge -- "$@"
    ;;
  clean)
    require_root_for_deb clean
    apt_get clean
    ;;
  autoclean)
    require_root_for_deb autoclean
    apt_get autoclean
    ;;
  snapshot)
    shift; run_snapshot "$@"
    ;;
  snapshots)
    shift; run_snapshot_list
    ;;
  rollback)
    shift; run_rollback "$@"
    ;;
  rollback-cleanup)
    shift; run_rollback_cleanup "$@"
    ;;
  set)
    shift
    case "${1:-}" in
      apt=*) set_apt "${1#apt=}" ;;
      deb=*) set_deb_apps "${1#deb=}" ;;
      *) say_err "Usage: auxi set apt=true|false | deb=true|false" "Usage: auxi set apt=true|false | deb=true|false"; exit 64 ;;
    esac
    ;;
  status)
    echo "AuxiNux OS 0.2.0"
    if apt_enabled; then
      say "APT direct: actif" "Direct APT: enabled"
    else
      say "APT direct: masque, utilisez auxi" "Direct APT: hidden, use auxi"
    fi
    if deb_apps_enabled; then
      say "Installation DEB: active (Flatpak reste prioritaire)" "DEB installation: enabled (Flatpak stays first)"
    else
      say "Installation DEB: desactivee, applications Flatpak seulement" "DEB installation: disabled, Flatpak applications only"
    fi
    if snapshots_available; then
      say "Rollback systeme: actif (BTRFS + snapper)" \
          "System rollback: enabled (BTRFS + snapper)"
      snapper -c "${SNAPPER_CONFIG}" list 2>/dev/null | tail -n 5 || true
    else
      say "Rollback systeme: indisponible sur ce systeme" \
          "System rollback: unavailable on this system"
    fi
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    say_err "Commande inconnue: $1" "Unknown command: $1"
    usage >&2
    exit 64
    ;;
esac
