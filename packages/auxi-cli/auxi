#!/usr/bin/env bash
set -euo pipefail

APT_CONF="/etc/auxinux/apt.conf"
APT_REAL_DIR="/usr/lib/auxinux/apt-real"
SNAPPER_CONFIG="root"
BTRFS_TOPLEVEL_MNT="/run/auxinux-btrfs-toplevel"
SNAPSHOT_OVERLAY_LOWER="/run/auxinux-snapshot/lower"

is_english() {
  local locale_chain="${LC_ALL:-}|${LC_MESSAGES:-}|${LANGUAGE:-}|${LANG:-}"
  [[ "${locale_chain}" =~ (^|[|:])en([_.]|$) ]]
}

say() {
  local fr="$1"
  local en="$2"
  if is_english; then
    printf '%s\n' "${en}"
  else
    printf '%s\n' "${fr}"
  fi
}

say_err() {
  local fr="$1"
  local en="$2"
  if is_english; then
    printf '%s\n' "${en}" >&2
  else
    printf '%s\n' "${fr}" >&2
  fi
}

usage() {
  if is_english; then
    cat <<'EOF'
auxi - AuxiNux OS administration command

Usage:
  auxi update [--deb|--flatpak]
  auxi upgrade [--deb|--flatpak]
  auxi search [--deb|--flatpak] TERM
  auxi install [--deb|--flatpak] PACKAGE_OR_APP
  auxi uninstall [--deb|--flatpak] PACKAGE_OR_APP
  auxi purge PACKAGE
  auxi clean
  auxi autoclean
  auxi snapshot [DESCRIPTION]
  auxi snapshots
  auxi rollback [NUMBER] [--yes]
  auxi rollback-cleanup [--yes]
  auxi set apt=true|false
  auxi status
EOF
  else
    cat <<'EOF'
auxi - commande d'administration AuxiNux OS

Usage:
  auxi update [--deb|--flatpak]
  auxi upgrade [--deb|--flatpak]
  auxi search [--deb|--flatpak] TERME
  auxi install [--deb|--flatpak] PAQUET_OU_APP
  auxi uninstall [--deb|--flatpak] PAQUET_OU_APP
  auxi purge PAQUET
  auxi clean
  auxi autoclean
  auxi snapshot [DESCRIPTION]
  auxi snapshots
  auxi rollback [NUMERO] [--yes]
  auxi rollback-cleanup [--yes]
  auxi set apt=true|false
  auxi status
EOF
  fi
}

require_root_for_config() {
  if [[ "${EUID}" -ne 0 ]]; then
    say_err \
      "Cette action doit etre executee avec sudo: sudo auxi $*" \
      "This action must be run with sudo: sudo auxi $*"
    exit 1
  fi
}

require_root_for_deb() {
  if [[ "${EUID}" -ne 0 ]]; then
    say_err \
      "Les operations DEB doivent etre executees avec sudo." \
      "DEB operations must be run with sudo."
    say_err \
      "Exemple: sudo auxi $*" \
      "Example: sudo auxi $*"
    exit 1
  fi
}

apt_real() {
  # Toujours appeler le vrai binaire APT directement.
  # Ne jamais retomber sur command -v: cela resoudrait le wrapper
  # /usr/bin/apt-get qui, avec APT_ENABLED=0, bloquerait auxi lui-meme.
  local name="$1"
  if [[ -x "${APT_REAL_DIR}/${name}" ]]; then
    echo "${APT_REAL_DIR}/${name}"
  else
    say_err \
      "Binaire APT introuvable: ${APT_REAL_DIR}/${name}" \
      "APT binary not found: ${APT_REAL_DIR}/${name}"
    say_err \
      "Installation auxi incomplete; verifiez install-auxi-cli.sh." \
      "Incomplete auxi installation; check install-auxi-cli.sh."
    exit 70
  fi
}

apt_enabled() {
  [[ -r "${APT_CONF}" ]] && grep -Eq '^APT_ENABLED=1$' "${APT_CONF}"
}

set_apt() {
  require_root_for_config set "apt=$1"
  install -d -m 0755 /etc/auxinux
  case "$1" in
    true|1|yes)
      printf 'APT_ENABLED=1\n' >"${APT_CONF}"
      say \
        "APT direct reactive. La commande recommandee reste auxi." \
        "Direct APT re-enabled. The recommended command remains auxi."
      ;;
    false|0|no)
      printf 'APT_ENABLED=0\n' >"${APT_CONF}"
      say \
        "APT direct masque. Utilisez auxi pour les operations utilisateur." \
        "Direct APT hidden. Use auxi for user package operations."
      ;;
    *)
      say_err \
        "Valeur invalide: apt=$1" \
        "Invalid value: apt=$1"
      exit 64
      ;;
  esac
}

# --- Instantanes systeme (BTRFS + snapper) ---------------------------------
#
# Tout ce bloc doit se degrader silencieusement: une racine ext4, un snapper
# absent ou une session live n'ont pas d'instantanes, et cela ne doit JAMAIS
# empecher une installation de paquet d'aboutir.

# Vrai quand le systeme a demarre sur un instantane depuis le menu GRUB. Dans
# ce cas la racine visible est un overlay (voir le hook initramfs
# auxinux-snapshot-overlay): interroger "/" renverrait « overlay » et le nom de
# peripherique « auxinux-snapshot ». C'est PRECISEMENT la situation ou l'on a
# besoin de `auxi rollback`, et sans cette distinction la commande refusait de
# s'executer.
booted_from_snapshot() {
  [[ -d "${SNAPSHOT_OVERLAY_LOWER}" ]] || return 1
  grep -qw 'auxinux.snapshot=1' /proc/cmdline 2>/dev/null
}

# Point de montage a interroger pour connaitre le VRAI systeme de fichiers
# racine, instantane compris.
root_mount_ref() {
  if booted_from_snapshot; then
    printf '%s' "${SNAPSHOT_OVERLAY_LOWER}"
  else
    printf '/'
  fi
}

snapshots_available() {
  command -v snapper >/dev/null 2>&1 || return 1
  [[ "$(findmnt -no FSTYPE "$(root_mount_ref)" 2>/dev/null)" == "btrfs" ]] || return 1
  [[ -f "/etc/snapper/configs/${SNAPPER_CONFIG}" ]] || return 1
  return 0
}

require_snapshots() {
  if snapshots_available; then
    return 0
  fi
  say_err \
    "Les instantanes ne sont pas disponibles sur ce systeme." \
    "Snapshots are not available on this system."
  say_err \
    "Ils exigent une racine BTRFS avec snapper configure (voir docs/rollback.md)." \
    "They require a BTRFS root with snapper configured (see docs/rollback.md)."
  exit 69
}

# Les instantanes automatiques ne sont PLUS poses ici.
#
# Ils le sont par /usr/lib/auxinux/apt-snapshot-hook, branche sur DPkg::Pre-
# Invoke et DPkg::Post-Invoke (voir /etc/apt/apt.conf.d/80auxinux-snapshot).
# Tant que la logique vivait dans `auxi`, toute autre voie vers dpkg -- `apt`
# reactive par `auxi set apt=true`, PackageKit, un script tiers -- modifiait le
# systeme sans filet, alors que l'interface affirmait le contraire. Attache a
# dpkg, l'instantane couvre desormais tous les chemins, `auxi` compris: le
# dupliquer ici produirait deux paires pre/post par transaction.
#
# AUXI_NO_SNAPSHOT=1 reste honore: le hook lit la meme variable, transmise par
# l'environnement jusqu'a apt-get.

run_snapshot() {
  require_snapshots
  require_root_for_config snapshot "$@"
  local description="${*:-Instantane manuel}"
  local number
  number="$(snapper -c "${SNAPPER_CONFIG}" create \
    --type single --print-number --cleanup-algorithm number \
    --description "${description}" \
    --userdata "auxi=1")"
  say \
    "Instantane ${number} cree: ${description}" \
    "Snapshot ${number} created: ${description}"
}

run_snapshot_list() {
  require_snapshots
  snapper -c "${SNAPPER_CONFIG}" list
}

# Restauration. Sur une disposition plate "@" (la notre), `snapper rollback`
# ne suffit PAS: il joue sur le sous-volume par defaut, alors que /etc/fstab
# monte la racine par CHEMIN (subvol=@). On echange donc les sous-volumes.
#
# L'operation est sure depuis un systeme en cours d'execution: renommer un
# sous-volume monte n'affecte pas le montage courant, et c'est au prochain
# demarrage que subvol=@ resout vers le sous-volume restaure.
run_rollback() {
  require_snapshots
  require_root_for_config rollback "$@"

  local assume_yes=0
  local number=""
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --yes|-y) assume_yes=1 ;;
      *) number="${arg}" ;;
    esac
  done

  if [[ -z "${number}" ]]; then
    run_snapshot_list
    say \
      "Choisissez un numero, puis: sudo auxi rollback NUMERO" \
      "Pick a number, then run: sudo auxi rollback NUMBER"
    return 0
  fi

  if [[ ! "${number}" =~ ^[0-9]+$ ]]; then
    say_err "Numero d'instantane invalide: ${number}" "Invalid snapshot number: ${number}"
    exit 64
  fi

  local root_source root_device
  root_source="$(findmnt -no SOURCE "$(root_mount_ref)" 2>/dev/null || true)"
  # findmnt rend "/dev/sda2[/@]" sur un sous-volume: on retire le suffixe.
  root_device="${root_source%%\[*}"
  if [[ -z "${root_device}" ]]; then
    say_err "Peripherique racine introuvable." "Could not determine root device."
    exit 69
  fi

  mkdir -p "${BTRFS_TOPLEVEL_MNT}"
  if ! mount -o subvolid=5 "${root_device}" "${BTRFS_TOPLEVEL_MNT}"; then
    say_err \
      "Montage de la racine BTRFS impossible: ${root_device}" \
      "Could not mount the BTRFS top level: ${root_device}"
    exit 69
  fi
  trap auxi_rollback_cleanup EXIT

  # @snapshots est un sous-volume de premier niveau (voir mount.conf); on
  # accepte quand meme la disposition imbriquee des installations anciennes.
  local snapshot_src=""
  local candidate
  for candidate in \
    "${BTRFS_TOPLEVEL_MNT}/@snapshots/${number}/snapshot" \
    "${BTRFS_TOPLEVEL_MNT}/@/.snapshots/${number}/snapshot"; do
    if [[ -d "${candidate}" ]]; then
      snapshot_src="${candidate}"
      break
    fi
  done

  if [[ -z "${snapshot_src}" ]]; then
    say_err "Instantane ${number} introuvable." "Snapshot ${number} not found."
    exit 69
  fi

  local stamp saved
  stamp="$(date +%Y%m%d-%H%M%S)"
  saved="@.rollback-${stamp}"

  say \
    "Restauration de l'instantane ${number}." \
    "Restoring snapshot ${number}."
  say \
    "Le systeme actuel est conserve sous ${saved} et /home n'est pas touche." \
    "The current system is kept as ${saved} and /home is left untouched."
  say \
    "Le changement prend effet au prochain demarrage." \
    "The change takes effect on next boot."

  if [[ "${assume_yes}" -ne 1 ]]; then
    local answer
    say "Confirmer? [o/N]" "Confirm? [y/N]"
    read -r answer
    case "${answer}" in
      o|O|oui|OUI|y|Y|yes|YES) ;;
      *)
        say "Restauration annulee." "Rollback cancelled."
        return 0
        ;;
    esac
  fi

  if ! mv "${BTRFS_TOPLEVEL_MNT}/@" "${BTRFS_TOPLEVEL_MNT}/${saved}"; then
    say_err \
      "Mise de cote du systeme actuel impossible; rien n'a ete modifie." \
      "Could not move the current system aside; nothing was changed."
    exit 69
  fi

  if ! btrfs subvolume snapshot "${snapshot_src}" "${BTRFS_TOPLEVEL_MNT}/@"; then
    # Sans cette remise en place, la machine n'aurait plus AUCUNE racine "@"
    # et ne redemarrerait pas. C'est le seul point vraiment dangereux.
    mv "${BTRFS_TOPLEVEL_MNT}/${saved}" "${BTRFS_TOPLEVEL_MNT}/@" || true
    say_err \
      "Restauration echouee; le systeme d'origine a ete remis en place." \
      "Rollback failed; the original system has been restored."
    exit 69
  fi

  say \
    "Restauration prete. Redemarrez pour l'appliquer: sudo reboot" \
    "Rollback ready. Reboot to apply it: sudo reboot"
  say \
    "Ancien systeme conserve sous le sous-volume ${saved}." \
    "Previous system kept as subvolume ${saved}."
  say \
    "Une fois le redemarrage valide, vous pouvez le supprimer:" \
    "Once the reboot is confirmed working, you can delete it:"
  printf '  sudo auxi rollback-cleanup\n'
}

# Suppression des systemes mis de cote par une restauration.
#
# `auxi rollback` conserve DELIBEREMENT l'ancien systeme sous @.rollback-<date>
# -- c'est le seul recours si la restauration s'avere pire que la panne. Mais
# rien ne les supprimait ensuite: chaque restauration laissait une copie
# complete du systeme sur le disque, jusqu'a saturation. La suppression reste
# manuelle et explicite; elle cesse simplement d'exiger trois commandes
# recopiees a la main.
run_rollback_cleanup() {
  require_root_for_config rollback-cleanup "$@"

  local assume_yes=0 arg
  for arg in "$@"; do
    case "${arg}" in
      --yes|-y) assume_yes=1 ;;
    esac
  done

  local root_source root_device
  root_source="$(findmnt -no SOURCE "$(root_mount_ref)" 2>/dev/null || true)"
  root_device="${root_source%%\[*}"
  if [[ -z "${root_device}" ]]; then
    say_err "Peripherique racine introuvable." "Could not determine root device."
    exit 69
  fi

  mkdir -p "${BTRFS_TOPLEVEL_MNT}"
  if ! mount -o subvolid=5 "${root_device}" "${BTRFS_TOPLEVEL_MNT}"; then
    say_err \
      "Montage de la racine BTRFS impossible: ${root_device}" \
      "Could not mount the BTRFS top level: ${root_device}"
    exit 69
  fi
  trap auxi_rollback_cleanup EXIT

  local saved=()
  local candidate
  for candidate in "${BTRFS_TOPLEVEL_MNT}"/@.rollback-*; do
    [[ -d "${candidate}" ]] || continue
    saved+=("${candidate}")
  done

  if [[ "${#saved[@]}" -eq 0 ]]; then
    say \
      "Aucun systeme mis de cote par une restauration." \
      "No system set aside by a rollback."
    return 0
  fi

  say \
    "Systemes conserves par une restauration precedente:" \
    "Systems kept by a previous rollback:"
  for candidate in "${saved[@]}"; do
    printf '  %s\n' "$(basename "${candidate}")"
  done
  say \
    "Ne les supprimez qu'apres avoir verifie que le systeme restaure demarre." \
    "Only delete these once you have confirmed the restored system boots."

  if [[ "${assume_yes}" -ne 1 ]]; then
    local answer
    say "Supprimer definitivement? [o/N]" "Delete permanently? [y/N]"
    read -r answer
    case "${answer}" in
      o|O|oui|OUI|y|Y|yes|YES) ;;
      *)
        say "Suppression annulee." "Deletion cancelled."
        return 0
        ;;
    esac
  fi

  local failures=0
  for candidate in "${saved[@]}"; do
    if btrfs subvolume delete "${candidate}" >/dev/null 2>&1; then
      say "Supprime: $(basename "${candidate}")" "Deleted: $(basename "${candidate}")"
    else
      failures=$((failures + 1))
      say_err \
        "Suppression impossible: $(basename "${candidate}")" \
        "Could not delete: $(basename "${candidate}")"
    fi
  done
  [[ "${failures}" -eq 0 ]] || exit 69
}

auxi_rollback_cleanup() {
  umount "${BTRFS_TOPLEVEL_MNT}" >/dev/null 2>&1 || true
  rmdir "${BTRFS_TOPLEVEL_MNT}" >/dev/null 2>&1 || true
}

select_mode() {
  MODE="both"
  if [[ "${1:-}" == "--deb" ]]; then
    MODE="deb"
    shift
  elif [[ "${1:-}" == "--flatpak" ]]; then
    MODE="flatpak"
    shift
  fi
  ARGS=("$@")
}

run_update() {
  select_mode "$@"
  if [[ "${MODE}" == "both" || "${MODE}" == "flatpak" ]]; then
    flatpak update --appstream -y || true
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "deb" ]]; then
    require_root_for_deb update "$@"
    "$(apt_real apt-get)" update
  fi
}

run_upgrade() {
  select_mode "$@"
  if [[ "${MODE}" == "both" || "${MODE}" == "flatpak" ]]; then
    flatpak update -y
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "deb" ]]; then
    require_root_for_deb upgrade "$@"
    "$(apt_real apt-get)" upgrade
  fi
}

run_search() {
  select_mode "$@"
  local term="${ARGS[0]:-}"
  if [[ -z "${term}" ]]; then
    say_err "Recherche manquante." "Missing search term."
    exit 64
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "flatpak" ]]; then
    echo "== Flatpak =="
    flatpak search -- "${term}" || true
  fi
  if [[ "${MODE}" == "both" || "${MODE}" == "deb" ]]; then
    echo "== DEB =="
    "$(apt_real apt-cache)" search -- "${term}" || true
  fi
}

run_install() {
  select_mode "$@"
  local item="${ARGS[0]:-}"
  if [[ -z "${item}" ]]; then
    say_err \
      "Element a installer manquant." \
      "Missing package or application to install."
    exit 64
  fi
  if [[ "${MODE}" == "flatpak" ]]; then
    flatpak install -y flathub -- "${item}"
  elif [[ "${MODE}" == "deb" ]]; then
    require_root_for_deb install "$@"
    "$(apt_real apt-get)" install -- "${item}"
  else
    if flatpak remote-ls flathub --app 2>/dev/null | awk '{print $1}' | grep -Fxq "${item}"; then
      flatpak install -y flathub -- "${item}"
    else
      say \
        "Aucun Flatpak exact trouve pour ${item}; installation DEB." \
        "No exact Flatpak found for ${item}; using DEB installation."
      require_root_for_deb install "$@"
      "$(apt_real apt-get)" install -- "${item}"
    fi
  fi
}

run_uninstall() {
  select_mode "$@"
  local item="${ARGS[0]:-}"
  if [[ -z "${item}" ]]; then
    say_err \
      "Element a desinstaller manquant." \
      "Missing package or application to uninstall."
    exit 64
  fi
  if [[ "${MODE}" == "flatpak" ]]; then
    flatpak uninstall -y -- "${item}"
  elif [[ "${MODE}" == "deb" ]]; then
    require_root_for_deb uninstall "$@"
    "$(apt_real apt-get)" remove -- "${item}"
  else
    require_root_for_deb uninstall "$@"
    # Une desinstallation Flatpak ne modifie pas l'etat systeme capture par
    # "@": aucun instantane n'est pose tant qu'on ne retombe pas sur DEB, ce
    # dont le hook dpkg se charge desormais.
    if ! flatpak uninstall -y -- "${item}"; then
      "$(apt_real apt-get)" remove -- "${item}"
    fi
  fi
}

case "${1:-}" in
  update)
    shift; run_update "$@"
    ;;
  upgrade)
    shift; run_upgrade "$@"
    ;;
  search)
    shift; run_search "$@"
    ;;
  install)
    shift; run_install "$@"
    ;;
  uninstall|remove)
    shift; run_uninstall "$@"
    ;;
  purge)
    shift
    require_root_for_deb purge "$@"
    "$(apt_real apt-get)" purge -- "$@"
    ;;
  clean)
    require_root_for_deb clean
    "$(apt_real apt-get)" clean
    ;;
  autoclean)
    require_root_for_deb autoclean
    "$(apt_real apt-get)" autoclean
    ;;
  snapshot)
    shift; run_snapshot "$@"
    ;;
  snapshots)
    shift; run_snapshot_list
    ;;
  rollback)
    shift; run_rollback "$@"
    ;;
  rollback-cleanup)
    shift; run_rollback_cleanup "$@"
    ;;
  set)
    shift
    case "${1:-}" in
      apt=*) set_apt "${1#apt=}" ;;
      *) say_err "Usage: auxi set apt=true|false" "Usage: auxi set apt=true|false"; exit 64 ;;
    esac
    ;;
  status)
    echo "AuxiNux OS 0.2.0"
    if apt_enabled; then
      say "APT direct: actif" "Direct APT: enabled"
    else
      say "APT direct: masque, utilisez auxi" "Direct APT: hidden, use auxi"
    fi
    if snapshots_available; then
      say "Rollback systeme: actif (BTRFS + snapper)" \
          "System rollback: enabled (BTRFS + snapper)"
      snapper -c "${SNAPPER_CONFIG}" list 2>/dev/null | tail -n 5 || true
    else
      say "Rollback systeme: indisponible sur ce systeme" \
          "System rollback: unavailable on this system"
    fi
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    say_err "Commande inconnue: $1" "Unknown command: $1"
    usage >&2
    exit 64
    ;;
esac
