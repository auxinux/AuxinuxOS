#!/bin/sh
# /usr/lib/os-release (« AuxiNux OS 0.2.0 ») appartient a base-files, et HORS
# de /etc: ce n'est pas un fichier de configuration, donc une mise a jour de
# base-files (chaque version intermediaire de Debian 13) l'aurait remplace par
# « Debian GNU/Linux 13 » -- partout: centre de controle, connexion, a propos.
# Le paquet le detourne: la version de Debian est gardee sous
# /usr/lib/os-release.debian, et rendue si ce paquet est retire.
set -e
case "$1" in
  install|upgrade)
    dpkg-divert --package auxinuxos-release --add --rename \
      --divert /usr/lib/os-release.debian /usr/lib/os-release
    ;;
esac
exit 0
