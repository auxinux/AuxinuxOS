# Defauts KDE d'AuxiNuxOS. /etc/xdg est lu AVANT ~/.config: ce sont des
# defauts, chaque utilisateur peut les changer et sa version l'emporte.
[General]
# Aucun navigateur par defaut impose (2026-10-02): l'image n'en contient plus,
# et l'assistant de premier demarrage declare celui que la personne choisit
# (xdg-settings set default-web-browser).

[KDE]
# Simple clic pour ouvrir: c'est le defaut de KDE. On l'ecrit explicitement
# parce que c'est la premiere chose que les nouveaux venus signalent, et qu'on
# veut un defaut STABLE d'une version de Plasma a l'autre.
SingleClick=false

[UserFeedback]
# Meme intention que /etc/xdg/PlasmaUserFeedback, pour les applications KDE
# qui lisent leur propre section au lieu du fichier global.
StatisticsCollectionMode=NoTelemetry
