#!/usr/bin/env bash
set -euo pipefail

target="${1:-}"

if [[ -z "${target}" ]]; then
  echo "Aucun fichier Windows fourni." >&2
  exit 64
fi

message="Ce fichier semble etre une application Windows.

AuxiNuxOS peut tenter de la lancer avec Wine, mais une alternative Linux ou Flatpak est souvent preferable pour la securite et la stabilite.

Voulez-vous essayer de la lancer avec Wine?"

if command -v kdialog >/dev/null 2>&1; then
  if kdialog --yesno "${message}" --title "Application Windows detectee"; then
    exec wine "${target}"
  fi
  exit 0
fi

printf '%s\n[y/N] ' "${message}" >&2
read -r answer
case "${answer}" in
  y|Y|yes|YES|oui|OUI) exec wine "${target}" ;;
  *) exit 0 ;;
esac
