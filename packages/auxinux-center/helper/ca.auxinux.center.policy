<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>AuxiNux OS</vendor>
  <vendor_url>https://os.auxinux.ca/auxinuxos</vendor_url>

  <!--
    Action dediee a l'ajout d'un depot APT depuis le centre de controle.

    Sans elle, l'invite d'authentification annoncait « executer bash » sur un
    script temporaire: l'utilisateur autorisait une elevation de privileges
    sans savoir ce qu'elle allait faire.
  -->
  <action id="ca.auxinux.center.manage-sources">
    <description>Add a software source</description>
    <description xml:lang="fr">Ajouter une source de logiciels</description>
    <message>Authentication is required to add a software source to this system</message>
    <message xml:lang="fr">Une authentification est requise pour ajouter une source de logiciels à ce système</message>
    <icon_name>application-x-addon</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/auxinux/auxinux-source-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!--
    Action de l'assistant de premier demarrage: installer en une fois les
    applications choisies. Une seule invite pour toute la selection, et un
    message qui dit ce qui va etre fait, plutot que « executer un programme ».
  -->
  <action id="ca.auxinux.center.assistant-apply">
    <description>Install the chosen applications</description>
    <description xml:lang="fr">Installer les applications choisies</description>
    <message>Authentication is required to install the applications you chose</message>
    <message xml:lang="fr">Une authentification est requise pour installer les applications que vous avez choisies</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/auxinux/auxinux-assistant-apply</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <!--
    Actualiser les listes de paquets: SANS mot de passe pour la session
    locale active. Telecharger des listes signees depuis les sources deja
    configurees ne change aucun logiciel installe (PackageKit fait de meme).
    Avant, l'action generique de pkexec demandait un mot de passe, en anglais
    (« run /usr/bin/auxi ... update as the super user »), et une
    invite fermee donnait « Not authorized » (2026-10-09).
  -->
  <action id="ca.auxinux.center.refresh">
    <description>Refresh the package lists</description>
    <description xml:lang="fr">Actualiser les listes de paquets</description>
    <message>Authentication is required to refresh the package lists</message>
    <message xml:lang="fr">Une authentification est requise pour actualiser les listes de paquets</message>
    <icon_name>view-refresh</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/auxinux/auxinux-refresh-helper</annotate>
  </action>

  <!--
    Mettre a jour le systeme (tout, AuxiNux OS seul, ou un paquet DEB deja
    installe). Une invite qui dit ce qui va etre fait, gardee quelques
    minutes pour enchainer les mises a jour.
  -->
  <action id="ca.auxinux.center.system-update">
    <description>Update AuxiNux OS</description>
    <description xml:lang="fr">Mettre à jour AuxiNux OS</description>
    <message>Authentication is required to update AuxiNux OS (a restore point is created first)</message>
    <message xml:lang="fr">Une authentification est requise pour mettre à jour AuxiNux OS (un point de restauration est créé avant)</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/auxinux/auxinux-update-helper</annotate>
  </action>
  <!--
    Choisir le bureau ouvert a la connexion (AuxiNux Shell ou KDE Plasma):
    ecrit la session par defaut de SDDM pour toute la machine (2026-10-10).
  -->
  <action id="ca.auxinux.center.desktop-session">
    <description>Choose the desktop</description>
    <description xml:lang="fr">Choisir le bureau</description>
    <message>Authentication is required to change the desktop opened at login</message>
    <message xml:lang="fr">Une authentification est requise pour changer le bureau ouvert à la connexion</message>
    <icon_name>preferences-desktop</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/auxinux/auxinux-session-helper</annotate>
  </action>
</policyconfig>
